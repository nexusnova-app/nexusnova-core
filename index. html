<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NexusNova - Security Verification</title>
  <script src="https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.umd.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }

    /* 1. CLOUDFLARE STYLE VERIFICATION SCREEN */
    #security-gate {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: #000000;
      color: #ffffff;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 60px 24px 40px 24px;
      z-index: 9999;
    }
    .sec-header {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 38px;
      font-weight: 800;
      letter-spacing: -0.5px;
      margin-bottom: 24px;
      word-break: break-all;
    }
    .sec-sub-title {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 18px;
      color: #f8fafc;
    }
    .sec-desc {
      font-size: 15px;
      color: #94a3b8;
      line-height: 1.6;
      max-width: 380px;
    }
    .sec-footer {
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      padding-top: 18px;
      text-align: center;
      font-size: 12px;
      color: #64748b;
    }
    .sec-footer a { color: #94a3b8; text-decoration: none; margin-left: 5px; }

    /* 2. REGISTRATION & AUTH VIEW */
    body {
      background: #fdf2f4;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px 14px;
    }
    .auth-container {
      width: 100%;
      max-width: 420px;
      background: #ffffff;
      border-radius: 24px;
      padding: 32px 24px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
      border: 1px solid rgba(229, 231, 235, 0.8);
      display: none;
    }
    .logo-area { text-align: center; margin-bottom: 24px; }
    .brand-logo {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 28px;
      font-weight: 800;
      letter-spacing: 1.5px;
      background: linear-gradient(135deg, #a855f7, #ec4899);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .brand-tag {
      font-size: 11px;
      color: #9333ea;
      font-weight: 700;
      letter-spacing: 1.8px;
      text-transform: uppercase;
      margin-top: 3px;
    }
    .page-title {
      font-size: 20px;
      font-weight: 800;
      color: #1e293b;
      text-align: center;
      margin-bottom: 24px;
    }
    .form-group { margin-bottom: 18px; }
    .form-label { display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 8px; }
    .form-input {
      width: 100%; height: 48px; border: 1.5px solid #e2e8f0; border-radius: 12px;
      padding: 0 16px; font-size: 14px; color: #1e293b; outline: none;
    }
    .form-input:disabled { background: #f8fafc; color: #64748b; }
    .btn-action {
      width: 100%; height: 52px; background: #7c3aed; color: #ffffff; border: none;
      border-radius: 12px; font-size: 15px; font-weight: 700; display: flex;
      align-items: center; justify-content: center; gap: 10px; cursor: pointer; margin-top: 10px;
    }
    .divider { height: 1px; background: #f1f5f9; margin: 24px 0 18px 0; }
    .sub-link { text-align: center; font-size: 13px; color: #64748b; margin-bottom: 12px; }
    .sub-link a { color: #7c3aed; text-decoration: none; font-weight: 700; cursor: pointer; }
    .footer-rules { text-align: center; font-size: 13px; color: #64748b; margin-top: 24px; padding-top: 16px; border-top: 1px solid #f8fafc; }
    .status-alert {
      padding: 12px 14px; border-radius: 10px; font-size: 12.5px; margin-bottom: 16px;
      display: none; text-align: center;
    }
    .status-alert.error { background: #fee2e2; color: #dc2626; display: block; }
    .status-alert.success { background: #dcfce7; color: #15803d; display: block; }
    .status-alert.info { background: #e0f2fe; color: #0369a1; display: block; }

    /* 3. DASHBOARD VIEW */
    #dashboard-view {
      display: none; width: 100%; max-width: 520px; background: #0f172a;
      border-radius: 24px; padding: 24px; color: #fff;
    }
    .dash-box { background: #1e293b; border-radius: 14px; padding: 16px; margin-bottom: 14px; }
  </style>
</head>
<body>

  <!-- CLOUDFLARE STYLE SECURITY VERIFICATION (OPENED FIRST) -->
  <div id="security-gate">
    <div>
      <div class="sec-header" id="sec-domain-text">nexusnova.app</div>
      <div class="sec-sub-title">Performing security verification</div>
      <p class="sec-desc">
        This website uses a security service to protect against malicious bots. This page is displayed while the website verifies you are not a bot.
      </p>
    </div>
    <div class="sec-footer">
      Ray ID: <span id="ray-id">a47cb51a0a19dae4</span><br>
      Performance and Security by <strong style="color:#cbd5e1;">Cloudflare</strong> | <a href="#">Privacy</a>
    </div>
  </div>

  <!-- AUTHENTICATION CARD -->
  <div class="auth-container" id="auth-view">
    <div class="logo-area">
      <div class="brand-logo">NEXUSNOVA</div>
      <div class="brand-tag">INFINITY IS THE LIMIT</div>
    </div>

    <div class="page-title" id="page-heading">Create a new account</div>
    <div id="status-msg" class="status-alert"></div>

    <div id="reg-fields">
      <div class="form-group">
        <label class="form-label">Username</label>
        <input type="text" id="username-inp" class="form-input" placeholder="Enter your Name">
      </div>

      <div class="form-group">
        <label class="form-label">Sponsor</label>
        <input type="text" id="sponsor-inp" class="form-input" value="0x33E4677827502E3089A66CfcFBd5C11C77C6680e">
      </div>
    </div>

    <div class="form-group" id="wallet-group" style="display: none;">
      <label class="form-label">Wallet Account</label>
      <input type="text" id="wallet-disp" class="form-input" disabled>
    </div>

    <button class="btn-action" id="main-btn" onclick="handleAuthAction()">
      🦊 <span id="btn-text">Connect Wallet</span>
    </button>

    <div class="divider"></div>

    <div class="sub-link">
      <span id="switch-prompt">Already have an account?</span> 
      <a onclick="toggleAuthMode()" id="switch-action">Sign in</a>
    </div>

    <div class="sub-link">
      If you made already a tranx? <a onclick="showAlert('Checking blockchain hash...', 'info')">Sign Up With Tranx</a>
    </div>

    <div class="footer-rules">
      Click here to learn about the rules
    </div>
  </div>

  <!-- DASHBOARD VIEW -->
  <div id="dashboard-view">
    <div style="text-align: center; margin-bottom: 20px;">
      <h2 style="color: #ec4899; font-family:'Space Grotesk';">NEXUSNOVA DASHBOARD</h2>
      <p style="font-size: 12px; color: #94a3b8;">Welcome, <span id="user-display-name">Member</span>!</p>
    </div>

    <div class="dash-box">
      <div style="font-size: 12px; color: #94a3b8;">Connected Wallet:</div>
      <div id="dash-wallet" style="font-family: monospace; color: #38bdf8; font-size: 13px; margin-top: 4px;">--</div>
    </div>

    <div class="dash-box">
      <div style="display: flex; justify-content: space-between;">
        <span>Account Status:</span>
        <span style="color: #10b981; font-weight: 700;">Active ($2 Paid)</span>
      </div>
    </div>

    <button class="btn-action" style="background: #ef4444;" onclick="location.reload()">
      Logout
    </button>
  </div>

  <script>
    const CONTRACT_ADDRESS = "0x56b92f91a648a3622460DB435968582DFc286d30";
    const USDT_ADDRESS = "0x55d398326f99059fF775485246999027B3197955";
    const ADMIN_WALLET = "0x33E4677827502E3089A66CfcFBd5C11C77C6680e";

    const CONTRACT_ABI = [
      "function registerAndBuy(address sponsor, uint256 amount) external",
      "function users(address) external view returns (bool isRegistered, uint256 globalIndex, address sponsor, uint256 totalEarned, uint256 totalWithdrawn, uint256 directCount)"
    ];
    const ERC20_ABI = [
      "function approve(address spender, uint256 amount) external returns (bool)",
      "function allowance(address owner, address spender) external view returns (uint256)",
      "function balanceOf(address account) external view returns (uint256)"
    ];

    let provider, signer, userAddress;
    let isLoginMode = false;
    let isConnected = false;

    // Security Gate Simulation
    window.addEventListener('load', () => {
      // Auto set domain text
      document.getElementById('sec-domain-text').innerText = window.location.hostname || "nexusnova.app";
      document.getElementById('ray-id').innerText = Math.random().toString(16).substring(2, 10) + Math.random().toString(16).substring(2, 10);

      // 2.5 seconds bot verification wait
      setTimeout(() => {
        document.getElementById('security-gate').style.display = 'none';
        document.getElementById('auth-view').style.display = 'block';
        if (window.ethereum) connectWallet();
      }, 2500);

      const p = new URLSearchParams(window.location.search);
      const ref = p.get('ref');
      if (ref) document.getElementById('sponsor-inp').value = ref;
    });

    function showAlert(msg, type = "info") {
      const box = document.getElementById('status-msg');
      box.innerText = msg;
      box.className = "status-alert " + type;
      setTimeout(() => { box.className = "status-alert"; }, 6000);
    }

    function toggleAuthMode() {
      isLoginMode = !isLoginMode;
      const heading = document.getElementById('page-heading');
      const regFields = document.getElementById('reg-fields');
      const switchPrompt = document.getElementById('switch-prompt');
      const switchAction = document.getElementById('switch-action');
      const btnText = document.getElementById('btn-text');

      if (isLoginMode) {
        heading.innerText = "Sign In to Account";
        regFields.style.display = "none";
        switchPrompt.innerText = "Don't have an account?";
        switchAction.innerText = "Create Account";
        btnText.innerText = isConnected ? "Enter Dashboard" : "Connect & Sign In";
      } else {
        heading.innerText = "Create a new account";
        regFields.style.display = "block";
        switchPrompt.innerText = "Already have an account?";
        switchAction.innerText = "Sign in";
        btnText.innerText = isConnected ? "Pay $2 USDT & Register" : "Connect Wallet";
      }
    }

    async function handleAuthAction() {
      if (!window.ethereum) {
        showAlert("Please open in Trust Wallet / MetaMask DApp browser!", "error");
        return;
      }
      if (!isConnected) {
        await connectWallet();
        return;
      }
      if (isLoginMode) {
        await checkExistingUserAndEnter();
      } else {
        await executeRegisterPayment();
      }
    }

    async function connectWallet() {
      try {
        provider = new ethers.providers.Web3Provider(window.ethereum);
        const accs = await provider.send("eth_requestAccounts", []);
        if (accs.length > 0) {
          signer = provider.getSigner();
          userAddress = await signer.getAddress();
          isConnected = true;

          document.getElementById('wallet-group').style.display = "block";
          document.getElementById('wallet-disp').value = userAddress;

          const contract = new ethers.Contract(CONTRACT_ADDRESS, CONTRACT_ABI, signer);
          const u = await contract.users(userAddress);
          const btnText = document.getElementById('btn-text');

          if (u.isRegistered) {
            btnText.innerText = "Exist Wallet! Enter Dashboard";
            document.getElementById('main-btn').onclick = openDashboard;
          } else {
            btnText.innerText = isLoginMode ? "Enter Dashboard" : "Pay $2 USDT & Register";
          }
        }
      } catch (err) {
        showAlert("Connection error: " + (err.reason || err.message), "error");
      }
    }

    async function executeRegisterPayment() {
      const uName = document.getElementById('username-inp').value.trim();
      if (!uName) {
        showAlert("Please enter your Username / Name first!", "error");
        return;
      }

      let sponsor = document.getElementById('sponsor-inp').value.trim();
      if (!ethers.utils.isAddress(sponsor)) sponsor = ADMIN_WALLET;

      try {
        const usdt = new ethers.Contract(USDT_ADDRESS, ERC20_ABI, signer);
        const contract = new ethers.Contract(CONTRACT_ADDRESS, CONTRACT_ABI, signer);
        const reqAmt = ethers.utils.parseUnits("2", 18);

        const bal = await usdt.balanceOf(userAddress);
        if (bal.lt(reqAmt)) {
          showAlert("Insufficient balance! Minimum $2.00 USDT required.", "error");
          return;
        }

        const allowance = await usdt.allowance(userAddress, CONTRACT_ADDRESS);
        if (allowance.lt(reqAmt)) {
          showAlert("Please approve $2 USDT in your wallet...", "info");
          const txA = await usdt.approve(CONTRACT_ADDRESS, ethers.constants.MaxUint256);
          await txA.wait();
        }

        showAlert("Confirming $2 USDT Registration fee...", "info");
        const tx = await contract.registerAndBuy(sponsor, reqAmt);
        await tx.wait();

        showAlert("Registered successfully!", "success");
        setTimeout(openDashboard, 1500);

      } catch (err) {
        showAlert("Transaction error: " + (err.reason || err.message), "error");
      }
    }

    async function checkExistingUserAndEnter() {
      try {
        const contract = new ethers.Contract(CONTRACT_ADDRESS, CONTRACT_ABI, signer);
        const u = await contract.users(userAddress);
        if (u.isRegistered) {
          openDashboard();
        } else {
          showAlert("This wallet is not registered! Switch to Create Account.", "error");
        }
      } catch (e) {
        showAlert("Network error reading account.", "error");
      }
    }

    function openDashboard() {
      document.getElementById('auth-view').style.display = "none";
      document.getElementById('dashboard-view').style.display = "block";
      document.getElementById('dash-wallet').innerText = userAddress;
      const uName = document.getElementById('username-inp').value.trim();
      if (uName) document.getElementById('user-display-name').innerText = uName;
    }
  </script>
</body>
</html>
